# Copy to .env and fill in. The app reads .env but real environment
# variables always win, so a container or systemd unit can override any line.

# Optional: first-run default for the MCip address. A demo admin sets the
# address (and the API client key) in the GUI under Settings; that value wins.
# Base URL only — the demo appends /api/v1/ext itself.
MCIP_BASE_URL=

# Allow an http:// MCip address for a non-local host (labs only).
DEMO_ALLOW_INSECURE_MCIP=false

# Fernet key that encrypts the stored MCip API keys at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it secret and stable: rotating it disconnects every stored connection.
DEMO_ENCRYPTION_KEY=

# Random string (32+ chars) that signs the demo's session cookies.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
DEMO_SESSION_SECRET=

# Public registration is closed by default; users are created with
# `python -m app.admin_cli add-user <name>`. Set to true only for a demo
# you do not mind strangers signing up for.
DEMO_ALLOW_REGISTER=false

# Set true when the demo is served over HTTPS (it then marks the session
# cookie Secure). Keep false for http://localhost.
DEMO_HTTPS_ONLY=false

# Trust the CF-Connecting-IP header for client IPs (rate limiting, logs).
# On by default because the documented deployment is a loopback-bound port
# behind the Cloudflare tunnel, where only Cloudflare can set the header.
# Set false if the port is ever reachable from anywhere else.
# DEMO_TRUST_CF_HEADER=true

# Where the SQLite file lives (default: ./data/demo.db).
# DEMO_DB_PATH=./data/demo.db

# Listen port (default 8090).
# DEMO_PORT=8090

# Per-minute limits, counted per client IP (login) and per user (chat).
# DEMO_LOGIN_RATE_PER_MIN=5
# DEMO_CHAT_RATE_PER_MIN=20
